{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch CMake Target - MSVC",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${command:cmake.launchTargetPath}",
      "args": ["-i", "${workspaceFolder}/input.txt"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    }
  ]
}
