{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Сборка C++",
      "type": "shell",
      "command": "g++",
      "args": [
        "-g",
        "-O0",
        "${file}",
        "-o",
        "${fileDirname}\\${fileBasenameNoExtension}.exe"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$gcc",
      "detail": "Сборка текущего C файла"
    }
  ]
}